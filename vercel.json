{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/transactions", "destination": "/index.html" },
    { "source": "/accounts", "destination": "/index.html" },
    { "source": "/budgets", "destination": "/index.html" },
    { "source": "/goals", "destination": "/index.html" },
    { "source": "/reports", "destination": "/index.html" },
    { "source": "/categories", "destination": "/index.html" },
    { "source": "/bills", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/help", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://gqdyfzdygjmqrxnopmnl.supabase.co; connect-src 'self' https://gqdyfzdygjmqrxnopmnl.supabase.co wss://gqdyfzdygjmqrxnopmnl.supabase.co; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}

